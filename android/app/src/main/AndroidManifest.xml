<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
<!-- Background location: lets GPS stream survive when the app is minimised -->
<uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
<!-- Foreground service: required by Geolocator's ForegroundNotificationConfig -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<!-- Android 14+ requires a typed foreground-service permission for location -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
<!-- Foreground service (2026-05-17) — driver online + partner loja aberta.
     dataSync = heartbeat 30s para Supabase; required em Android 14+. -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
<!-- Android 13+ runtime permission para mostrar notificações (POST_NOTIFICATIONS).
     Necessário para a notificação persistente do foreground service +
     pedidos urgentes do canal 'bora_orders_urgent'. -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<!-- Vibração para notificações urgentes de novo pedido. -->
<uses-permission android:name="android.permission.VIBRATE"/>
<!-- Sessão 2026-05-18 — Full-screen intent estilo Uber/Glovo: permite que a
     notificação de novo pedido acorde o ecrã e seja mostrada sobre o lock
     screen com botões aceitar/rejeitar. Exigido em Android 10+ para
     fullScreenIntent=true funcionar. Em Android 14+ requer também que o
     utilizador conceda a permissão "Apps que podem mostrar ecrã completo"
     em Definições → Apps → Bora → Notificações. -->
<uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
<!-- Necessário para o sistema acordar/manter o ecrã ligado quando chega o
     fullScreenIntent com app fechada. -->
<uses-permission android:name="android.permission.TURN_SCREEN_ON"/>
<!-- Boot completed (opcional) — flutter_foreground_task permite autoRunOnBoot
     mas mantemos autoRunOnBoot=false; perm declarada para compatibilidade. -->
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
<!-- Wake-lock: prevents CPU from sleeping while tracking is active -->
<uses-permission android:name="android.permission.WAKE_LOCK"/>
<!-- Battery optimisation: permite pedir ao utilizador para excluir a app
     da gestão de bateria → foreground service sobrevive em background longo. -->
<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
<!-- Draw over other apps: necessário para flutter_foreground_task mostrar
     overlay estilo Uber/Glovo por cima de outras apps. -->
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
<!-- Sessão 2026-05-21 — flutter_overlay_window: card de oferta de pedido
     novo por cima de outras apps. Em Android 14+ requer specialUse FGS. -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
<!-- Sessão 2026-05-22 — Android 12+ FCM data-only com fullScreenIntent +
     background overlay exige FOREGROUND_SERVICE_REMOTE_MESSAGING. Sem isto
     Android 14+ mata o foreground service ao acordar pelo FCM de background
     e o overlay nunca chega a ser desenhado quando driver está noutra app. -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING"/>
<!-- Camera: profile photo, sendPackage photo, carryGroceries photo (BR §7.5/§7.6), partner product photo -->
<uses-permission android:name="android.permission.CAMERA"/>
<!-- Gallery access for partner product photo: Android 13+ uses READ_MEDIA_IMAGES, older uses READ_EXTERNAL_STORAGE -->
<uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
<!-- L3 (2026-06-12) — login com biometria (digital/rosto) via local_auth/
     BiometricPrompt. USE_FINGERPRINT cobre Android <9 (deprecated mas
     recomendado pelo plugin para compatibilidade). -->
<uses-permission android:name="android.permission.USE_BIOMETRIC"/>
<uses-permission android:name="android.permission.USE_FINGERPRINT"/>
        <application
        android:label="bora_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBYLjK1RtPdi4WM7pMGmupesBgUIWMkfkw"/>

        <!-- 2026-05-14: Google Pay (Stripe PaymentSheet). Habilita Wallet API
             no dispositivo Android para o sheet mostrar a opcao Google Pay
             quando configurada no Stripe Dashboard + SHA-1 release no Play Console. -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />

        <!-- 2026-05-22: FCM default channel id. Critico para heads-up em background:
             sem este meta-data, quando o FCM SDK recebe a mensagem com app fora
             do foreground, cai no canal default (IMPORTANCE_DEFAULT) e a
             notificacao NAO aparece como heads-up. Tem de bater certo com o
             channel_id criado em MainActivity.kt + main.dart + payload FCM. -->
        <!-- Sessão 2026-05-24 (exec2 FIX A): canal v3 com som EXPLÍCITO
             bora_alert (v2 nasceu sem setSound — Android trancou-o em default).
             MainActivity.kt cria este canal com AudioAttributes ringtone +
             FLAG_AUDIBILITY_ENFORCED. Tem de bater certo com o channel ID
             usado em notification_service.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bora_orders_urgent_v3"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task v8.17 — service DEVE ser declarado manualmente
             aqui (o próprio package SÓ declara receivers — RebootReceiver,
             RestartReceiver — confirmado em pub cache).
             Exec6.17 BUGFIX (2026-05-25): nome anterior 'com.foregroundtask.
             FlutterForegroundTaskService' era do v6/v7 e apontava para classe
             inexistente em v8 → startService retornava true mas service NUNCA
             arrancava (isRunningService=false em todos os testes).
             Nome correcto v8: com.pravera.flutter_foreground_task.service.ForegroundService -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync|remoteMessaging"/>

        <!-- flutter_overlay_window — Sessão 2026-05-21. Serviço que desenha o
             card da oferta por cima de outras apps quando FCM new_order_offer
             chega com app em background. Android 14+ requer specialUse FGS
             + property com descrição user-facing. -->
        <service
            android:name="flutter.overlay.window.flutter_overlay_window.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mostra card de novo pedido ao estafeta quando o app está em background"/>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sessão 7-UI-BUG004: tel: launcher para botão "Ligar agora" do
             bottom sheet de cancelamento bloqueado pós-pickedUp. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
