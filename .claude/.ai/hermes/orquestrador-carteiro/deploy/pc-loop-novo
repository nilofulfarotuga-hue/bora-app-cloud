#!/bin/sh
# pc-loop-novo — ponte do EXECUTOR do loop (container -> tailscale -> PC).
#
# 2026-09-05 (sessao fila-ganho-05-09) — A TAREFA DEIXA DE IR PELO STDIN.
# ---------------------------------------------------------------------
# A mesma doenca do pc-judge-novo, e apanhada no mesmo dia: uma ordem com 3460 B
# de tarefa devolveu "Timeout, server 100.75.79.116 not responding" sem o
# executor ter chegado a correr — nem o ficheiro da tarefa foi escrito no PC.
# Acima de cerca de 2 KB de base64, o pipe entre o ssh e o cmd.exe enche e a
# ligacao morre aos ~180 s. O ficheiro segue agora por scp (57 KB em 1 s,
# medido) e o .cmd corre sem stdin.
#
# O run-claude-loop-pcnovo-limpo.cmd nao precisou de bandeira nova: so
# descodifica quando o primeiro argumento e --b64stdin, e mais a frente exige
# que o ficheiro da tarefa exista. Com --jaentregue salta a descodificacao e usa
# o ficheiro que o scp acabou de pousar.
#
# Se a entrega falhar, NAO se corre o executor: correr com o ficheiro da corrida
# anterior seria executar a ordem errada, em silencio.
set -u

PC=danil@100.75.79.116
DESTINO='AppData/Local/Temp/bora_loop_task.txt'
CMDPC='C:\BoraLocal\Desktop-PC-antigo\produtividade-ia\hermes-bridge\run-claude-loop-pcnovo-limpo.cmd'

TMP=$(mktemp /tmp/orq_loop_entrega.XXXXXX) || { echo "[loop] ERRO: sem sitio para o ficheiro de entrega"; exit 5; }
printf '%s' "$*" > "$TMP"

if ! scp -q -o ProxyCommand="tailscale nc %h %p" \
         -o StrictHostKeyChecking=accept-new \
         -o ConnectTimeout=25 \
         "$TMP" "$PC:$DESTINO" 2>/dev/null; then
  rm -f "$TMP"
  echo "[loop] ERRO: entrega da tarefa por scp falhou — nao corro o executor para nao repetir a ordem da corrida anterior"
  exit 5
fi
rm -f "$TMP"

ssh -o ProxyCommand="tailscale nc %h %p" \
    -o StrictHostKeyChecking=accept-new \
    -o ConnectTimeout=25 \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=6 \
    "$PC" "$CMDPC --jaentregue" < /dev/null
