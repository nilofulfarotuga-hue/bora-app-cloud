+
+    final vivos = await vivosFut;
+    final historico = await historicoFut;
+    _haMaisHistoricoEstafeta = historico.length > ate + 1;
+
+    final frescos = <String, OrderModel>{};
+    for (final data in [...vivos, ...historico.take(ate + 1)]) {
