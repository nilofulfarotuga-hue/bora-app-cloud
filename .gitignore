backend/*.json.json
google-services.json
GoogleService-Info.plist
.env
backend/.env
*.pem
*.p12
*.keystore
*.jks
key.properties
android/key.properties

# ── Obsidian vault (.obsidian-vault/) — local config & cache ──────────────────
# Vault canónico vive em bora_app/.obsidian-vault/ (commit 2026-05-04).
# Setup partilhável commitado: notas .md + lista de plugins.
# Ignorado: caches, workspace, plugins binários, smart-env (>1MB).
.obsidian-vault/.obsidian/workspace*
.obsidian-vault/.obsidian/workspace.json
.obsidian-vault/.obsidian/cache
.obsidian-vault/.obsidian/app.json
.obsidian-vault/.obsidian/plugins/
.obsidian-vault/.obsidian/themes/
.obsidian-vault/.smart-env/
.obsidian-vault/.trash/
# Artefacto plugin: .obsidian/.obsidian/ recursivo (preservado em disco
# para SHA256 match com source, mas NAO commitado - contem .exe + caches)
.obsidian-vault/.obsidian/.obsidian/
.obsidian-vault/.obsidian/.smart-env/
testsprite_tests\tmp\config.json

# MCP config (contém API keys)
.mcp.json

# ── Cérebro: memória de trabalho efémera (Fase 2) ────────────────────────────
# Checkpoints de tarefas são descartáveis; só o .gitkeep é versionado.
.claude/.ai/knowledge/sessao/*
!.claude/.ai/knowledge/sessao/.gitkeep

# ── Backups descartáveis ─────────────────────────────────────────────────────
*.bak

# ── Graphify: grafo de código gerado (não versionar — regenerável via AST) ────
graphify-out/
.graphify/
.graphify_analysis.json
.graphify_labels.json

