+  Future<void> _loadOrdersDoEstafeta(String uid) async {
+    final vivosFut = supabase
+        .from('orders')
+        .select()
+        .or(filtroPedidosDoEstafeta(uid))
+        .not('status', 'in', listaEstadosFinaisPostgrest())
+        .order('created_at', ascending: false)
+        .timeout(const Duration(seconds: 8));
+    // Pede-se uma linha a mais do que as páginas abertas: se vier, há mais.
+    final ate = intervaloDaPaginaHistorico(_paginasHistoricoEstafeta - 1).ate;
