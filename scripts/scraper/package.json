{
  "name": "bora-scraper",
  "version": "1.0.0",
  "description": "Product scraper for Bora App supermarkets",
  "main": "scrape.js",
  "type": "module",
  "scripts": {
    "start": "node scrape.js",
    "continente": "node scrape.js --only=continente",
