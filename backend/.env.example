# Copy this file to .env and fill in your values

# Stripe secret key (test mode: starts with sk_test_...)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Port for the backend server (default: 3000)
PORT=3000

# Supabase (server-side only — use the SERVICE ROLE key, never the anon key)
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# ── Gerador de Imagens (generate_product_images.js) ──────────────────────────
# OpenAI API key — obrigatório para gerar imagens com DALL-E
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE

# Modelo: dall-e-3 ($0.04/img) | dall-e-2 ($0.018/img)
MODEL=dall-e-3

# Batch size (produtos por lote)
BATCH_SIZE=10

# Simular sem gastar créditos (true/false)
DRY_RUN=false

# Ignorar produtos que já têm imagem (true = não regera)
SKIP_IF_HAS_IMAGE=true

# Filtrar por categoria (ex: Frutas) — vazio = todas
CATEGORY_FILTER=

# Limitar número de produtos processados (ex: 10 para teste) — vazio = sem limite
PRODUCT_LIMIT=
