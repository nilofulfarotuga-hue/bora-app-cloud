# ── Miscellaneous ─────────────────────────────────────────────────────────────
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ── Flutter run artifacts (debug screenshots / capture) ──────────────────────
flutter_*.png
flutter_*.jpg

# ── Ad-hoc dumps / scratch files ─────────────────────────────────────────────
temp_*.sql
temp_*.json
*.dump
schema_dump_*.sql

# ── JVM heap dumps (gigabyte-sized crash files) ───────────────────────────────
*.hprof
hs_err_pid*.log
replay_pid*.log

# ── IntelliJ / Android Studio ────────────────────────────────────────────────
*.iml
*.ipr
*.iws
.idea/

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/

# ── Flutter / Dart / Pub ──────────────────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# ── Android build outputs ─────────────────────────────────────────────────────
android/.gradle/
android/app/build/
android/build/
*.apk
*.aab

# ── iOS / macOS build outputs ─────────────────────────────────────────────────
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
macos/Pods/
macos/.symlinks/

# ── Gradle wrapper caches ─────────────────────────────────────────────────────
.gradle/
*.tmp

# ── Symbolication / obfuscation maps ─────────────────────────────────────────
app.*.symbols
app.*.map.json

# ── Android Studio build artifacts ───────────────────────────────────────────
/android/app/debug
/android/app/profile
/android/app/release

# ── Lock files (regenerated by pub/npm) ──────────────────────────────────────
pubspec.lock

# ── Scraper secrets & output ──────────────────────────────────────────────────
scripts/scraper/.env
scripts/scraper/output/
scripts/scraper/node_modules/

# ── Claude Code local settings (per-machine, never commit) ───────────────────
.claude/settings.local.json

# ── Secrets / credentials (NEVER commit these) ────────────────────────────────
.dart_defines
backend/firebase-service-account.json
backend/firebase-service-account.json.json
backend/*.json.json
google-services.json
GoogleService-Info.plist
.env
backend/.env
*.pem
*.p12
*.keystore
