{
  "name": "dsh-bora",
  "description": "Plugin do Bora para o dsh (Dipsy): olhos (captura_ecra, ver_imagem), a guarda que barra ou PERGUNTA ao Danilo pelo Telegram antes de correr (dinheiro, publicar, apagar), e a pesquisa na internet pelo proxy com registo. Codigo nosso, sem dependencias de terceiros.",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts"
  ],
  "license": "UNLICENSED",
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dshx": {
    "contributes": {
      "tools": [
        "captura_ecra",
        "ver_imagem",
        "agendar_tarefa",
        "listar_agenda",
        "cancelar_tarefa",
        "memorizar",
        "lembrar",
        "esquecer",
        "passar_ao_claude_code",
        "criar_ferramenta",
        "promover_ferramenta",
        "usar_ferramenta_criada",
        "listar_ferramentas_criadas",
        "apagar_ferramenta",
        "libertar_memoria",
        "esperar_autorizacao",
        "pesquisar_internet"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node --test test/*.mjs"
  }
}
