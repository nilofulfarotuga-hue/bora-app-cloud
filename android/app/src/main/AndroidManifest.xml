<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
<!-- Background location: lets GPS stream survive when the app is minimised -->
<uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
<!-- Foreground service: required by Geolocator's ForegroundNotificationConfig -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<!-- Android 14+ requires a typed foreground-service permission for location -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
<!-- Foreground service (2026-05-17) — driver online + partner loja aberta.
     dataSync = heartbeat 30s para Supabase; required em Android 14+. -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
<!-- Android 13+ runtime permission para mostrar notificações (POST_NOTIFICATIONS).
     Necessário para a notificação persistente do foreground service +
     pedidos urgentes do canal 'bora_orders_urgent'. -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<!-- Vibração para notificações urgentes de novo pedido. -->
<uses-permission android:name="android.permission.VIBRATE"/>
<!-- Sessão 2026-05-18 — Full-screen intent estilo Uber/Glovo: permite que a
     notificação de novo pedido acorde o ecrã e seja mostrada sobre o lock
     screen com botões aceitar/rejeitar. Exigido em Android 10+ para
     fullScreenIntent=true funcionar. Em Android 14+ requer também que o
     utilizador conceda a permissão "Apps que podem mostrar ecrã completo"
     em Definições → Apps → Bora → Notificações. -->
<uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
<!-- Necessário para o sistema acordar/manter o ecrã ligado quando chega o
     fullScreenIntent com app fechada. -->
<uses-permission android:name="android.permission.TURN_SCREEN_ON"/>
<!-- Boot completed (opcional) — flutter_foreground_task permite autoRunOnBoot
     mas mantemos autoRunOnBoot=false; perm declarada para compatibilidade. -->
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
<!-- Wake-lock: prevents CPU from sleeping while tracking is active -->
<uses-permission android:name="android.permission.WAKE_LOCK"/>
<!-- Battery optimisation: permite pedir ao utilizador para excluir a app
     da gestão de bateria → foreground service sobrevive em background longo. -->
<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
<!-- Draw over other apps: necessário para flutter_foreground_task mostrar
     overlay estilo Uber/Glovo por cima de outras apps. -->
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
<!-- Camera: profile photo, sendPackage photo, carryGroceries photo (BR §7.5/§7.6), partner product photo -->
<uses-permission android:name="android.permission.CAMERA"/>
<!-- Gallery access for partner product photo: Android 13+ uses READ_MEDIA_IMAGES, older uses READ_EXTERNAL_STORAGE -->
<uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
        <application
        android:label="bora_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBYLjK1RtPdi4WM7pMGmupesBgUIWMkfkw"/>

        <!-- 2026-05-14: Google Pay (Stripe PaymentSheet). Habilita Wallet API
             no dispositivo Android para o sheet mostrar a opcao Google Pay
             quando configurada no Stripe Dashboard + SHA-1 release no Play Console. -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task v8.x — serviço necessário para foreground
             service real (driver online + parceiro loja aberta). Sem esta
             declaração startService() falha silenciosamente em Android 8+.
             foregroundServiceType=dataSync corresponde à permissão
             FOREGROUND_SERVICE_DATA_SYNC já declarada acima. -->
        <service
            android:name="com.foregroundtask.FlutterForegroundTaskService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sessão 7-UI-BUG004: tel: launcher para botão "Ligar agora" do
             bottom sheet de cancelamento bloqueado pós-pickedUp. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
