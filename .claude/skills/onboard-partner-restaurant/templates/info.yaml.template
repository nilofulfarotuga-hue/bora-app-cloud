  cuisine_type: "portuguesa"        #   tipo de cozinha (livre)
  category: "restaurante"           # * nesta skill: sempre 'restaurante'
  is_partner: true                  #   restaurante parceiro
  address: "Rua Direita 12, 6230-001 Guarda"   # * morada completa
  phone: "+351271123456"            # * telefone PT (+351 + 9 dígitos, começa 2/9)
  email: "geral@belmontegrill.pt"   # * email (vira o login do parceiro)
  nif: "509123456"                  #   NIF 9 dígitos (validação mód-11)
  iban: "PT50000700000012345678901" #   ⚠️ formato real: PT + 21 dígitos (23 chars)
  lat: null                         #   deixa null → preenchido por geocode.py
  lng: null
